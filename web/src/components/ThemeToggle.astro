---
/**
 * The site's only interactive control, and — together with the blocking script
 * in ThemeScript.astro — its only client JavaScript.
 *
 * It cycles system → light → dark rather than toggling two states, so a visitor
 * who lands in the wrong mode can always get back to "whatever my OS says"
 * without clearing site data. `data-theme` absent means "follow the OS", which
 * is exactly what the CSS in tokens.css keys on.
 */
---
<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-live="polite"
  data-label-system="Theme: system"
  data-label-light="Theme: light"
  data-label-dark="Theme: dark"
>
  <span id="theme-toggle-label">Theme</span>
</button>

<script is:inline>
  ;(function () {
    var btn = document.getElementById('theme-toggle')
    if (!btn) return
    var label = document.getElementById('theme-toggle-label')
    var root = document.documentElement
    var order = ['system', 'light', 'dark']

    function current() {
      var stored = null
      try {
        stored = localStorage.getItem('thor-theme')
      } catch (_) {
        // Private browsing and some embedded webviews throw on any access.
        // Falling back to "system" is correct: the OS preference still applies.
      }
      return order.indexOf(stored) === -1 ? 'system' : stored
    }

    function paint(mode) {
      if (mode === 'system') root.removeAttribute('data-theme')
      else root.setAttribute('data-theme', mode)
      if (label) label.textContent = btn.getAttribute('data-label-' + mode) || 'Theme'
    }

    paint(current())

    btn.addEventListener('click', function () {
      var next = order[(order.indexOf(current()) + 1) % order.length]
      try {
        if (next === 'system') localStorage.removeItem('thor-theme')
        else localStorage.setItem('thor-theme', next)
      } catch (_) {
        // Storage refused; the change still applies for this page view.
      }
      paint(next)
    })
  })()
</script>

<style>
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: var(--text-label-large);
    color: var(--on-surface-variant);
    background: transparent;
    /* --outline, not --outline-variant: the hairline is 1.6:1 in light and
       2.1:1 in dark, fine as a decorative rule and not fine as the only thing
       telling you where a button ends. */
    border: 1px solid var(--outline);
    border-radius: var(--radius-full);
    padding: var(--space-3xs) var(--space-xs);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--on-surface);
    background: var(--surface-container-high);
  }
</style>
