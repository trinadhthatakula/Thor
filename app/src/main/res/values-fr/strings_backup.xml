    <string name="backup_passphrase">Phrase secrète</string>
    <string name="backup_passphrase_confirm">Confirmer la phrase secrète</string>
    <string name="backup_passphrase_warning">Thor ne peut pas récupérer cette phrase secrète. Sans elle, cette sauvegarde ne pourra pas être restaurée.</string>
    <string name="backup_remember_passphrase">La mémoriser sur cet appareil</string>
