<!--
  European Portuguese (pt-PT) translation of values/strings_settings.xml.
  The comments below are the source file's translator notes, kept in English on
  purpose: they explain why a string is worded the way it is, and they are notes
  to maintainers rather than UI text.
-->
<resources>

    <!-- ── The eight categories ──────────────────────────────────────────────────────────────
         Title Case, unlike the SCREAMING CASE section labels they replace: these are screen
         titles and index rows now, not the small all-caps rubric above a group. `freezer`,
         `extensions` and `backup_and_restore` are already Title Case and are reused as they are. -->
    <string name="settings_category_appearance">Aspeto</string>
    <string name="settings_category_home">Ecrã principal</string>
    <string name="settings_category_installing">Instalação e partilha</string>
    <string name="settings_category_security">Segurança</string>
    <string name="settings_category_about">Sobre e apoio</string>

    <!-- ── Index chrome ──────────────────────────────────────────────────────────────────── -->
    <string name="settings_search_hint">Pesquisar nas definições…</string>
    <string name="settings_search_no_results">Nada nas Definições corresponde a «%1$s».</string>
    <string name="settings_search_result_in">em %1$s</string>
    <string name="cd_settings_search_clear">Limpar a pesquisa</string>
    <string name="cd_back">Retroceder</string>

    <!--
      The empty right-hand pane on a tablet or an unfolded foldable, before a category is picked.
      Never shown on a phone, where the index occupies the whole window and opening a category
      replaces it.
    -->
    <string name="settings_select_category">Escolha uma categoria para ver as respetivas definições</string>

    <!--
      The privilege picker's label for PrivilegeMode.NONE. Present for exhaustiveness only — the
      picker is built from the engines that probed available, so NONE is never one of its buttons.
      Worth a real string rather than an empty one: if it ever does render, "None" is a state a
      user can act on and `mode.name` is not.
    -->
    <string name="settings_engine_none">Nenhum</string>

    <!--
      The language row's description. It had none: the row's subtitle was the *current language*,
      which is the value, not what the setting does — so the row was the one entry in Settings that
      could not say what it was for, and search had nothing static to index it by.
    -->
    <string name="app_language_desc">O idioma dos ecrãs do próprio Thor</string>

    <!--
      Theme option labels. These were `ThemeMode.label()` returning hardcoded "Light"/"Dark"/
      "System" from a domain enum — English in all five locales, on the setting users flip most.
    -->
    <string name="theme_light">Claro</string>
    <string name="theme_dark">Escuro</string>
    <string name="theme_system">Sistema</string>

    <!-- ── Index summary lines ───────────────────────────────────────────────────────────────
         Each index row carries a line describing the state behind it, so that the door does not
         have to be opened to see what is through it. Joined with a middle dot by the caller. -->
    <string name="settings_summary_opens_on">Abre em %1$s</string>
    <string name="settings_summary_auto_freeze_on">Congelamento automático ativado</string>
    <string name="settings_summary_auto_freeze_off">Congelamento automático desativado</string>
    <string name="settings_summary_suspend_mode">Modo de suspensão</string>
    <string name="settings_summary_auto_reinstall_on">Reinstalação automática ativada</string>
    <string name="settings_summary_auto_reinstall_off">Reinstalação automática desativada</string>
    <string name="settings_summary_app_lock_on">Bloqueio ativado</string>
    <string name="settings_summary_app_lock_off">Bloqueio desativado</string>
    <string name="settings_summary_restore_interrupted">Um restauro não terminou</string>
    <string name="settings_summary_backup">Restaurar um arquivo ou alterar a frase-passe</string>
    <string name="settings_summary_unprivileged">Necessita de root, Shizuku ou Dhizuku</string>
    <string name="settings_summary_customization">Ações do painel da app e opções de esquema</string>

