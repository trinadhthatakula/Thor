default_platform(:android)

platform :android do

  # --- HELPER: Common Build Logic ---
  # Takes the Play track as a parameter: master's lane publishes to closed testing ('alpha'),
  # production's to open testing ('beta'). There is deliberately no default — a lane that uploads
  # must name where, and a lane that does not upload passes nothing.
  def prepare_release_artifacts(upload_to_store: false, track: nil, version_code: nil)
    UI.user_error!("❌ upload_to_store: true requires a track") if upload_to_store && track.nil?

    # 1. PREPARATION
    fastlane_dir = Dir.pwd
    project_root = File.expand_path("..", fastlane_dir)
    gradle_properties_path = File.join(project_root, "gradle.properties")

    # 2. CONFIGURATION & CHECKS
    UI.message("📝 Reading configuration...")
    unless File.exist?(gradle_properties_path)
      UI.user_error!("❌ gradle.properties not found at #{gradle_properties_path}")
    end

    # Parse properties
    properties = File.readlines(gradle_properties_path)
                     .map(&:strip)
                     .reject { |l| l.empty? || l.start_with?('#') }
                     .map { |l| l.split('=', 2).map(&:strip) }
                     .to_h

    # 3. DETERMINE VERSION CODE
    final_version_code = nil

    if version_code
      final_version_code = version_code.to_i
      UI.important("⚠️  Using MANUAL version code override: #{final_version_code}")
    else
      final_version_code = properties["versionCode"]&.to_i
      UI.user_error!("❌ 'versionCode' missing in gradle.properties") unless final_version_code
      UI.message("✅ Using defined version code from properties: #{final_version_code}")
    end

    # 4. GET VERSION NAME
    new_version_name = ""
    Dir.chdir(project_root) do
      new_version_name = sh("./gradlew -q app:printVersionName -PversionCode=#{final_version_code}").strip
    end

    UI.message("📦 Build Target: v#{new_version_name} (#{final_version_code}) - Track: #{track || 'none (not uploading)'}")

    # Save for GitHub Actions steps
    File.write(File.join(project_root, "version_name.txt"), new_version_name)
    File.write(File.join(project_root, "version_code.txt"), final_version_code.to_s)
    # The Telegram step announces the track, and until this file existed it announced a hardcoded
    # one — it still read "Internal Testing" after the lane had been pointed somewhere else, with
    # nothing in the repo able to notice. Deriving it here means the announcement cannot drift from
    # the upload again. Empty for a lane that uploads nothing.
    File.write(File.join(project_root, "track.txt"), track.to_s)

    # 5. BUILD ARTIFACTS
    # We build APKs (for GitHub/Telegram) AND Bundle (for Play Store)
    build_tasks = "clean copyStoreReleaseApk copyFossReleaseApk"
    build_tasks += " bundleStoreRelease" if upload_to_store

    gradle(
      task: build_tasks,
      project_dir: project_root,
      properties: {
        "versionCode" => final_version_code,
        "android.injected.version.code" => final_version_code
      }
    )

    # 6. DEPLOY (Conditional)
    if upload_to_store
      generated_aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
      UI.user_error!("❌ No AAB generated") unless generated_aab_path

      # Try to locate playstore.txt
      skip_changelogs = true
      changelog_dir = File.join(project_root, "release-notes", "v#{new_version_name}")
      playstore_notes_path = File.join(changelog_dir, "playstore.txt")

      unless File.exist?(playstore_notes_path)
        changelog_dir = File.join(project_root, "release-notes", new_version_name)
        playstore_notes_path = File.join(changelog_dir, "playstore.txt")
      end

      if File.exist?(playstore_notes_path)
        require 'fileutils'
        dest_dir = File.join(fastlane_dir, "metadata", "android", "en-US", "changelogs")
        FileUtils.mkdir_p(dest_dir)
        dest_file = File.join(dest_dir, "#{final_version_code}.txt")
        begin
          FileUtils.cp(playstore_notes_path, dest_file)
          UI.success("📝 Successfully copied Play Store release notes to #{dest_file}")
          skip_changelogs = false
        rescue => e
          UI.error("❌ Failed to copy Play Store release notes from #{playstore_notes_path} to #{dest_file}: #{e.message}")
          skip_changelogs = true
        end
      else
        UI.important("⚠️  No Play Store release notes found at: #{playstore_notes_path}. Skipping changelog upload.")
      end

      # Upload to the track the lane asked for ('alpha' = closed testing, 'beta' = open testing).
      # Nothing here ever writes 'production': promoting a build to production is a manual step in
      # the Play Console, and that manual step is the release gate.
      upload_to_play_store(
        track: track,
        release_status: 'completed', # live on that test track immediately; production stays manual
        aab: generated_aab_path,
        skip_upload_metadata: true,
        skip_upload_changelogs: skip_changelogs,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_apk: true
      )
      UI.success("🚀 Deployed to Play Store [#{track}]!")
    else
      UI.success("📦 Artifacts built successfully (Upload skipped)")
    end
  end

  # --- LANES ---

  desc "Dev: Build -> Play Store (Closed testing) -> Telegram -> GitHub Pre-release"
  lane :distribute_dev do
    # 'alpha' is the de-facto track key for "Closed testing" in the Play Console. Google's own
    # track table documents only 'production', 'beta' and 'qa'; 'alpha' is fastlane/GPP convention,
    # and it is the key the production lane published to before 2026-08-02, so it is known to work
    # against this app's Play listing.
    prepare_release_artifacts(upload_to_store: true, track: 'alpha')
  end

  desc "Prod: Build -> Play Store (Open testing) -> GitHub Release"
  lane :distribute_production do
    # 'beta' is Google's documented track key for "Open testing"
    prepare_release_artifacts(upload_to_store: true, track: 'beta')
  end

  # Helper for manual triggering
  desc "Build Release Candidates Only (No Store)"
  lane :build_release_candidates do |options|
    prepare_release_artifacts(
        upload_to_store: false,
        version_code: options[:version_code]
    )
  end
end